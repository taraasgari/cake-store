+  .od-steps::-webkit-scrollbar {
+    display: none;
+  }
+
+  /* ---------- Legacy Tailwind-like public templates ---------- */
+  .phase-main [class~="max-w-7xl"],
+  .phase-main [class~="max-w-6xl"],
+  .phase-main [class~="max-w-5xl"],
+  .phase-main [class~="max-w-4xl"],
+  .phase-main [class~="max-w-3xl"] {
+    width: calc(100% - 28px) !important;
+    max-width: none !important;
+    margin-right: auto !important;
+    margin-left: auto !important;
+  }
+
+  .phase-main [class*="grid-cols-"] {
+    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
+  }
+
+  /* ---------- Footer ---------- */
+  .p4-footer-grid {
+    grid-template-columns: 1fr 1fr !important;
+    gap: 24px 18px !important;
+  }
+
+  .p4-footer-brand,
+  .p4-footer-note {
+    grid-column: 1 / -1 !important;
+  }
+
+  .p4-footer-note form,
+  .p4-footer-note form > div {
+    width: 100% !important;
+  }
+
+  .p4-footer-note input {
+    min-width: 0 !important;
+  }
+
+  .p4-footer-bottom {
+    gap: 7px !important;
+    align-items: flex-start !important;
+    flex-direction: column !important;
+  }
+}
