# =========================
# Django
# =========================

# Enables fail-closed production validation.
DJANGO_ENV=production

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

ALLOWED_HOSTS=shop.example.com,www.shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com

# Simple single-container deployments can serve public uploads through Django.
# Prefer Nginx/object storage for high traffic.
SERVE_MEDIA=True

TIME_ZONE=Asia/Tehran
SITE_NAME=فروشگاه عطر


# =========================
# PostgreSQL
# =========================
# اگر DB_HOST خالی باشد، پروژه از SQLite استفاده می‌کند.

DB_HOST=db
DB_PORT=5432

POSTGRES_DB=perfume_shop
POSTGRES_USER=perfume_shop
POSTGRES_PASSWORD=replace-with-a-strong-database-password

DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10


# =========================
# Email
# =========================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

EMAIL_HOST_USER=mailbox@example.com
EMAIL_HOST_PASSWORD=replace-with-an-app-password
DEFAULT_FROM_EMAIL=mailbox@example.com


# =========================
# Initial owner account
# =========================
# فقط توسط create_owner.py استفاده می‌شود.

OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PHONE=09120000000
OWNER_PASSWORD=replace-with-a-strong-owner-password


# =========================
# Production security
# =========================

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False


# =========================
# Logging and static files
# =========================

LOG_LEVEL=INFO
WHITENOISE_MAX_AGE=31536000

# Report safety
MAX_PDF_ORDERS=500
